{
  "manifest_version": 3,
  "name": "petrichor",
  "short_name": "petrichor",
  "version": "1.0.0",
  "description": "petrichor startpage — clock, weather, stats, tasks and links on the site's own glass and gradient.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["js/background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "history"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "petrichor@local.ext",
      "strict_min_version": "115.0"
    }
  }
}
